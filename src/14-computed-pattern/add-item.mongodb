use("platzi_store")

db.orders.updateOne(
    {_id: ObjectId('67f96fb85ad27089fe8ef33b')},
    {
        $push: {
            items: {
                name: "Product 2",
                price: 45,
                qty: 4,
                product_id: ObjectId('67f4cbb49d87bd7774e68e90')
            },
        },
        $inc: {
            total: 45 * 4
        }
    }
)